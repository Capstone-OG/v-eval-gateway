<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>V_Eval_Gateway.API</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.17" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../../../grpc/ai.proto" GrpcServices="Client" Link="Protos/ai.proto" />
    <Protobuf Include="../../../grpc/auth.proto" GrpcServices="Client" Link="Protos/auth.proto" />
    <Protobuf Include="../../../grpc/content.proto" GrpcServices="Client" Link="Protos/content.proto" />
    <Protobuf Include="../../../grpc/practice.proto" GrpcServices="Client" Link="Protos/practice.proto" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\V-Eval-Gateway.Infrastructure\V-Eval-Gateway.Infrastructure.csproj" />
    <ProjectReference Include="..\V-Eval-Gateway.Application\V-Eval-Gateway.Application.csproj" />
  </ItemGroup>

</Project>
