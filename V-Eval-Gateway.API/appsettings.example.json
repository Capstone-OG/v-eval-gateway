{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "YOUR_PRODUCTION_JWT_SECRET_KEY_MIN_32_CHARACTERS",
    "Issuer": "YOUR_JWT_ISSUER",
    "Audience": "YOUR_JWT_AUDIENCE",
    "RefreshThresholdMinutes": 5
  },
  "ReverseProxy": {
    "Routes": {
      "ai-engine-api-route": {
        "ClusterId": "ai-engine-cluster",
        "Match": {
          "Path": "/api/ai-engine/{**catch-all}"
        }
      },
      "ai-engine-view-route": {
        "ClusterId": "ai-engine-cluster",
        "Match": {
          "Path": "/view-exam"
        }
      },
      "ai-engine-static-route": {
        "ClusterId": "ai-engine-cluster",
        "Match": {
          "Path": "/extracted_images/{**catch-all}"
        }
      },
      "content-service-route": {
        "ClusterId": "content-service-cluster",
        "Match": {
          "Path": "/api/content/{**catch-all}"
        }
      },
      "identity-service-route": {
        "ClusterId": "identity-service-cluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "practice-service-route": {
        "ClusterId": "practice-service-cluster",
        "Match": {
          "Path": "/api/practice/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "ai-engine-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "content-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5249"
          }
        }
      },
      "identity-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "practice-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  }
}
